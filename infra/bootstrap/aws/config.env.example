# Settings for the AWS bootstrap scripts.
#
#   cp config.env.example config.env   # then fill in the blanks
#
# config.env is git-ignored: it holds your email and user names. Never commit
# it. Values are plain shell assignments (no spaces around `=`).

# --- Management account (the one that already exists) ----------------------

# AWS CLI profile that signs in to the management account through IAM Identity
# Center with admin rights. Created by `aws configure sso`.
MGMT_PROFILE=management-admin
# The [sso-session ...] name from ~/.aws/config used by MGMT_PROFILE. The new
# project profile reuses it, so one `aws sso login` covers both accounts.
SSO_SESSION=my-sso

# --- Project account (created by 02-account.sh) ------------------------------

PROJECT_ACCOUNT_NAME=cferrante-dev
# Root email for the new account. Must not belong to any other AWS account.
# A "plus" address on an inbox you read works, e.g. you+cferrante-dev@example.com.
PROJECT_ACCOUNT_EMAIL=

# --- Access (03-sso-access.sh) ---------------------------------------------

# Your user name in the IAM Identity Center portal.
SSO_USERNAME=
# Existing permission set to grant in the project account.
PERMISSION_SET_NAME=AdministratorAccess
# CLI profile the script writes to ~/.aws/config for the project account.
PROJECT_PROFILE=cferrante-dev-admin

# --- Budget (04-budget.sh) -------------------------------------------------

BUDGET_NAME=monthly-1-usd
# Monthly limit in US dollars. Alerts fire at 1% (first cent spent) and 100%
# actual, and 100% forecast.
BUDGET_LIMIT_USD=1
# Where budget alerts are emailed.
BUDGET_EMAIL=

# --- DNS (05-dns.sh) -------------------------------------------------------

# Domain registered with Route 53 in the management account. Its DNS zone is
# created in the project account.
DOMAIN=cferrante.dev
# Region for the CLI profile. us-east-1 is required for CloudFront's ACM
# certificates; Route 53 and Budgets are global.
REGION=us-east-1
