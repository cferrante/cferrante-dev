# Local settings for `make dev`. Copy to .env (git-ignored) and edit.
# Precedence: command-line flag > shell environment > .env > built-in default.
# Never put secrets here: production secrets live in SSM (design §11).

# Where the dev server listens. Keep 127.0.0.1 so it isn't reachable from the network.
LISTEN_ADDR=127.0.0.1:8787

# Corpus to index and where to write the index.
CORPUS_DIR=orchestrator/corpus/testdata/corpus
INDEX_PATH=build/dev/corpus.idx

# Ollama, and the models it serves.
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3:4b
# low keeps qwen3's thinking short on a CPU (11 s instead of 373 s for a one-line sum).
# Unset: low for Ollama (qwen3 on a CPU), the provider's own default for Groq.
# REASONING_EFFORT=low
# To try tools locally, qwen3:4b is too slow to decide on this CPU; use
# CHAT_MODEL=llama3.1 with REASONING_EFFORT=none (it doesn't think, and rejects the field).

# ollama (EMBED_MODEL via Ollama) or hash (no Ollama needed, for quick runs).
EMBEDDER=ollama
EMBED_MODEL=nomic-embed-text
# 0 means the embedder's default: 768 for nomic-embed-text, 256 for hash.
EMBED_DIM=0

# true to act as an invitee, who also sees invitee-only documents.
DEV_INVITEE=false

# What the read-only tools answer (design §6). Keep these generic in a public repo.
CONTACT_OPTIONS=Invitees can send a message through this chat.
AVAILABILITY=Weekdays, office hours (not configured).

# Whole-turn limit (a Go duration). Production uses 60s; a CPU-only laptop
# needs longer, especially when the model also calls tools.
TURN_DEADLINE=5m

# The page's directory, served at / (design §14).
WEB_DIR=web

# The names the page shows; ASSISTANT_NAME also goes into the model's system prompt.
SITE_NAME=cferrante.dev
ASSISTANT_NAME=Context Concierge
# Optional JSON file overriding the friendly error messages (keys and the
# default wording: web/messages.example.json). Placeholders: {assistant}, {site}.
# MESSAGES_FILE=web/messages.json

# Real models (plan Phase 5). ollama (default) or groq. Groq needs a current AWS
# session (aws sso login --profile cferrante-dev-admin): its key is read from SSM at
# startup and never stored here.
CHAT_PROVIDER=ollama
GROQ_MODEL=openai/gpt-oss-120b
GROQ_KEY_PARAM=/cferrante-dev/groq-api-key
# The fallback when CHAT_PROVIDER=groq (Bedrock, same AWS profile).
BEDROCK_MODEL=us.amazon.nova-lite-v1:0
AWS_PROFILE=cferrante-dev-admin
AWS_REGION=us-east-1
