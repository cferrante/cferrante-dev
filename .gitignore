# JetBrains IDE settings (per developer)
.idea/

# Build output
/bin/
/dist/
/build/
*.zip

# Go
*.test
*.out
coverage.*

# Generated CSS (built by `make css`)
/web/dist/

# OpenTofu
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Local secrets and environment
.env
.env.*
!.env.example

# AWS bootstrap settings (your account email and user names);
# config.env.example is the committed template.
/infra/bootstrap/aws/config.env

# Invitee-only documents: a clone of the private corpus repo (corpus/README.md).
# make corpus-check fails if anything here is committed with git add -f.
/corpus/private/

# Spike build output
/spikes/*/build/
